@{
    ViewData["Title"] = "Leave Policy";
}

<h1>Leave Policy</h1>
<p class="alert alert-info">This is sample guidance for the Program 6 demonstration. The employee handbook and HR team are the authoritative sources for actual policy.</p>

<h2 class="h4">Requesting leave</h2>
<ul>
    <li>Submit a leave request with the dates, leave type, and a brief reason.</li>
    <li>Submit requests in advance where possible and coordinate coverage with your manager.</li>
    <li>A request remains pending until an authorized manager records a decision.</li>
</ul>

<h2 class="h4">Review and updates</h2>
<ul>
    <li>Check the leave status page for the current decision.</li>
    <li>Contact your manager or HR if a request needs correction or if you have questions about eligibility.</li>
    <li>Leave entitlements, notice periods, and supporting-document requirements must be confirmed in the organization's current policy.</li>
</ul>

<a asp-controller="Approval" asp-action="Status">Check leave status</a>
