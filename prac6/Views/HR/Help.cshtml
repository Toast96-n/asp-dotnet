@{
    ViewData["Title"] = "Employee Help";
}

<h1>Employee Help &amp; Support</h1>
<p>Use these steps to find help with leave requests and employee information.</p>

<div class="accordion" id="employeeHelp">
    <div class="accordion-item">
        <h2 class="accordion-header" id="leaveQuestion">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#leaveAnswer" aria-expanded="true" aria-controls="leaveAnswer">
                How do I apply for leave?
            </button>
        </h2>
        <div id="leaveAnswer" class="accordion-collapse collapse show" aria-labelledby="leaveQuestion" data-bs-parent="#employeeHelp">
            <div class="accordion-body">Open Apply Leave, complete the request details, and submit the form. Your request will initially have Pending status.</div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header" id="statusQuestion">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#statusAnswer" aria-expanded="false" aria-controls="statusAnswer">
                Where can I check my leave status?
            </button>
        </h2>
        <div id="statusAnswer" class="accordion-collapse collapse" aria-labelledby="statusQuestion" data-bs-parent="#employeeHelp">
            <div class="accordion-body">Visit <a asp-controller="Approval" asp-action="Status">Leave Status</a> to view pending, approved, and rejected requests.</div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header" id="supportQuestion">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#supportAnswer" aria-expanded="false" aria-controls="supportAnswer">
                Who can answer policy questions?
            </button>
        </h2>
        <div id="supportAnswer" class="accordion-collapse collapse" aria-labelledby="supportQuestion" data-bs-parent="#employeeHelp">
            <div class="accordion-body">Contact your reporting manager or the <a asp-controller="HR" asp-action="HRContacts">HR team</a>. Use your organization's verified directory details.</div>
        </div>
    </div>
</div>
