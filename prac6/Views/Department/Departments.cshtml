@model List<prac6.Models.DepartmentInfo>
@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>
<p class="text-muted">Sample organization directory. Replace the sample details with your organization's information.</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Department</th>
                <th>Overview</th>
                <th>Manager</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.Manager</td>
                    <td><a asp-action="DepartmentDetails" asp-route-id="@department.Id">View details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
