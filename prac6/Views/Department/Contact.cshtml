@model List<prac6.Models.DepartmentInfo>
@{
    ViewData["Title"] = "Department Contacts";
}

<h1>Department Contact Details</h1>
<p class="text-muted">Sample organization contact information. Confirm current contact details before use.</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Department</th>
                <th>Contact person</th>
                <th>Email</th>
                <th>Extension</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Name</td>
                    <td>@department.Manager</td>
                    <td><a href="mailto:@department.Email">@department.Email</a></td>
                    <td>@department.Extension</td>
                </tr>
            }
        </tbody>
    </table>
</div>
