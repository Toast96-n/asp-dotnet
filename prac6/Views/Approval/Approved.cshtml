@model List<prac6.Models.LeaveRequest>
@{
    ViewData["Title"] = "Approved Leave";
}

<h1>Approved Leave Requests</h1>
<p><a asp-action="Status">All statuses</a> | <a asp-action="Pending">Pending requests</a> | <a asp-action="Rejected">Rejected requests</a></p>

@if (Model.Count == 0)
{
    <p>There are no approved leave requests.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave dates</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@request.Name</td>
                        <td>@request.Department</td>
                        <td>@request.From – @request.To</td>
                        <td>@request.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
