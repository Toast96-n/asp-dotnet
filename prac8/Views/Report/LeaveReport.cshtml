@model IReadOnlyList<prac6.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Report";
}

<h1>Employee Leave Report</h1>
<p><a asp-action="Index">Back to reports</a></p>

@if (Model.Count == 0)
{
    <p>No leave requests are available for this report.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead><tr><th>Request</th><th>Employee</th><th>Department</th><th>From</th><th>To</th><th>Reason</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@request.Name</td>
                        <td>@request.Department</td>
                        <td>@request.From</td>
                        <td>@request.To</td>
                        <td>@request.Reason</td>
                        <td>@request.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
