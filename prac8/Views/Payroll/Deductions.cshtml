@model IReadOnlyList<prac6.Models.PayrollDeduction>
@{
    ViewData["Title"] = "Deductions";
}

<h1>Leave &amp; Deduction Details</h1>
<p class="text-muted">Sample payroll deductions for employee review.</p>
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead><tr><th>Type</th><th>Description</th><th>Amount</th></tr></thead>
        <tbody>
            @foreach (var deduction in Model)
            {
                <tr><td>@deduction.Type</td><td>@deduction.Description</td><td>@deduction.Amount.ToString("C")</td></tr>
            }
        </tbody>
    </table>
</div>
<p>For questions about a deduction, contact <a asp-controller="HR" asp-action="HRContacts">Human Resources</a>.</p>
