@model IReadOnlyList<prac6.Models.AttendanceRecord>
@{
    ViewData["Title"] = "Attendance History";
}

<h1>Attendance History</h1>
<p>Historical attendance records, newest first.</p>
<p><a asp-action="Index">Attendance overview</a> | <a asp-action="Summary">Monthly summary</a></p>

@if (Model.Count == 0)
{
    <p>No attendance history is available yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr><th>Date</th><th>Employee</th><th>Check-in</th><th>Check-out</th><th>Hours worked</th></tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.Date.ToString("D")</td>
                        <td>@record.EmployeeName</td>
                        <td>@record.CheckIn.ToString("t")</td>
                        <td>@(record.CheckOut?.ToString("t") ?? "Not recorded")</td>
                        <td>@record.HoursWorked.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
