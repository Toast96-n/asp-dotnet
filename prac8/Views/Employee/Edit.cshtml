<h1>Edit Employee</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           name="id"
           value="@TempData["Id"]" />

    <label>Name</label>
    <input type="text"
           name="name"
           value="@TempData["Name"]" />
    <br /><br />

    <label>Address</label>
    <input type="text"
           name="address"
           value="@TempData["Address"]" />
    <br /><br />

    <label>Department</label>
    <input type="text"
           name="department"
           value="@TempData["Department"]" />
    <br /><br />

    <label>Contact</label>
    <input type="text"
           name="contact"
           value="@TempData["Contact"]" />
    <br /><br />

    <button type="submit">Update</button>

</form>