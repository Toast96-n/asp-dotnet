@model IReadOnlyList<prac6.Models.NotificationItem>
@{
    ViewData["Title"] = "Leave and Holiday Reminders";
}

<h1>Leave and Holiday Reminders</h1>
<p>Keep up with leave planning and upcoming holidays.</p>
<nav class="mb-3">
    <a asp-action="Index">All notifications</a> |
    <a asp-action="Announcement">Announcements</a>
</nav>

@if (Model.Count == 0)
{
    <p>No leave or holiday reminders are available.</p>
}
else
{
    <div class="list-group">
        @foreach (var reminder in Model)
        {
            <a class="list-group-item list-group-item-action"
               asp-action="Message" asp-route-id="@reminder.Id">
                <div class="d-flex w-100 justify-content-between">
                    <h2 class="h5 mb-1">@reminder.Title</h2>
                    <small>@reminder.PublishedAt.ToString("d")</small>
                </div>
                <p class="mb-1">@reminder.Message</p>
                <small>@reminder.Category</small>
            </a>
        }
    </div>
}
