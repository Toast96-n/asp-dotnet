
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - prac6</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/prac6.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm
                    navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Website Name -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    prac6
                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse
                            d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>


                        <!-- Employees -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Employee"
                               asp-action="Employees">
                                Employees
                            </a>
                        </li>


                        <!-- Add Employee -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Employee"
                               asp-action="Create">
                                Add Employee
                            </a>
                        </li>


                        <!-- Leave Requests -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Leave"
                               asp-action="Index">
                                Leave Requests
                            </a>
                        </li>


                        <!-- Apply Leave -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Leave"
                               asp-action="Apply">
                                Apply Leave
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Approval"
                               asp-action="Status">
                                Leave Status
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Department"
                               asp-action="Departments">
                                Departments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="HR"
                               asp-action="Help">
                                HR Help
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="HR"
                               asp-action="HRContacts">
                                HR Contacts
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="employeeServicesMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Employee Services
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="employeeServicesMenu">
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="MyLeave">My leave</a></li>
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="MyProfile">My profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Calendar">Leave &amp; holiday calendar</a></li>
                                <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Index">Payroll</a></li>
                                <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Payslip">Payslips</a></li>
                                <li><a class="dropdown-item" asp-controller="Payroll" asp-action="SalaryDetails">Salary details</a></li>
                                <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Deductions">Deductions</a></li>
                                <li><a class="dropdown-item" asp-controller="Training" asp-action="Training">Training programs</a></li>
                                <li><a class="dropdown-item" asp-controller="Training" asp-action="Schedule">Training schedule</a></li>
                                <li><a class="dropdown-item" asp-controller="Training" asp-action="Certificate">Certificates</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="notificationsMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Notifications
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="notificationsMenu">
                                <li><a class="dropdown-item" asp-controller="Notification" asp-action="Index">All notifications</a></li>
                                <li><a class="dropdown-item" asp-controller="Notification" asp-action="Announcement">Announcements</a></li>
                                <li><a class="dropdown-item" asp-controller="Notification" asp-action="Reminder">Leave &amp; holiday reminders</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="attendanceMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Attendance
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="attendanceMenu">
                                <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">Records</a></li>
                                <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Mark">Mark attendance</a></li>
                                <li><a class="dropdown-item" asp-controller="Attendance" asp-action="History">History</a></li>
                                <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Summary">Monthly summary</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="reportsMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Reports
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="reportsMenu">
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Index">Report dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="LeaveReport">Leave report</a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="AttendanceReport">Attendance report</a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="EmployeeSummary">Employee summary</a></li>
                            </ul>
                        </li>


                        <!-- Privacy -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Page Content -->
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - prac6 -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
