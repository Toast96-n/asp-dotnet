@model List<prac6.Models.LeaveRequest>
@{
    ViewData["Title"] = "Pending Leave Requests";
}

<h1>Pending Leave Requests</h1>
<p>Review these requests and approve or reject each pending application.</p>

<p>
    <a asp-action="Status">All statuses</a> |
    <a asp-action="Approved">Approved</a> |
    <a asp-action="Rejected">Rejected</a>
</p>

@if (Model.Count == 0)
{
    <p>There are no pending leave requests.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave dates</th>
                    <th>Reason</th>
                    <th>Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@request.Name</td>
                        <td>@request.Department</td>
                        <td>@request.From – @request.To</td>
                        <td>@request.Reason</td>
                        <td>
                            <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
