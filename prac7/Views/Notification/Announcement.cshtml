@model IReadOnlyList<prac6.Models.NotificationItem>
@{
    ViewData["Title"] = "Company Announcements";
}

<h1>Company Announcements</h1>
<p>Updates and news for employees.</p>
<nav class="mb-3">
    <a asp-action="Index">All notifications</a> |
    <a asp-action="Reminder">Reminders</a>
</nav>

@if (Model.Count == 0)
{
    <p>No company announcements are available.</p>
}
else
{
    @foreach (var announcement in Model)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h2 class="h5 card-title">
                    <a asp-action="Message" asp-route-id="@announcement.Id">@announcement.Title</a>
                </h2>
                <p class="text-muted">@announcement.PublishedAt.ToString("D")</p>
                <p class="card-text">@announcement.Message</p>
            </div>
        </article>
    }
}
