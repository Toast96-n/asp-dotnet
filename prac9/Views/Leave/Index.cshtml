@model List<prac6.Models.LeaveRequest>

<h1>Leave Requests</h1>

<a asp-action="Apply">Apply Leave</a>

<br />
<br />

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>From</th>
        <th>To</th>
        <th>Status</th>
        <th>Details</th>
        
    </tr>

    @foreach (var leave in Model)
    {
        <tr>
            <td>@leave.Id</td>
            <td>@leave.Name</td>
            <td>@leave.Department</td>
            <td>@leave.From</td>
            <td>@leave.To</td>
            <td>@leave.Status</td>

            <td>
                <a asp-action="Details"
                   asp-route-id="@leave.Id">
                    Details
                </a>
            </td>
        </tr>
    }

</table>