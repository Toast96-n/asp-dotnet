@model IReadOnlyList<prac6.Models.EmployeeRecord>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Employees</h1>
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Contact</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Department</td>
                <td>@employee.Contact</td>
                <td>
                    <a asp-action="Profile" asp-route-id="@employee.Id">Profile</a>
                    <span class="mx-1">|</span>
                    <a asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                    <span class="mx-1">|</span>
                    <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this employee?');">
                        <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>