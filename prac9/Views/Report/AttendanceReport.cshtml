@model IReadOnlyList<prac6.Models.AttendanceRecord>
@{
    ViewData["Title"] = "Attendance Report";
}

<h1>Attendance Report</h1>
<p><a asp-action="Index">Back to reports</a></p>

@if (Model.Count == 0)
{
    <p>No attendance records are available for this report.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead><tr><th>Employee</th><th>Date</th><th>Check-in</th><th>Check-out</th><th>Hours worked</th></tr></thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.EmployeeName</td>
                        <td>@record.Date.ToString("d")</td>
                        <td>@record.CheckIn.ToString("t")</td>
                        <td>@(record.CheckOut?.ToString("t") ?? "Not recorded")</td>
                        <td>@record.HoursWorked.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
