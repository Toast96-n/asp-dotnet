@model prac6.Models.EmployeeProfile
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>
<div class="card" style="max-width: 42rem;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Employee ID</dt><dd class="col-sm-8">@Model.EmployeeId</dd>
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Job title</dt><dd class="col-sm-8">@Model.JobTitle</dd>
            <dt class="col-sm-4">Department</dt><dd class="col-sm-8"><a asp-controller="Department" asp-action="Departments">@Model.Department</a></dd>
            <dt class="col-sm-4">Manager</dt><dd class="col-sm-8">@Model.Manager</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
        </dl>
    </div>
</div>
