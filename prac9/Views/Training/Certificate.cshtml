@model IReadOnlyList<prac6.Models.TrainingCertificate>
@{
    ViewData["Title"] = "Training Certificates";
}

<h1>Completed Training Certificates</h1>
@if (Model.Count == 0)
{
    <p class="text-muted">No completed training certificates are available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead><tr><th>Course</th><th>Completed</th><th>Certificate ID</th></tr></thead>
            <tbody>
                @foreach (var certificate in Model)
                {
                    <tr><td>@certificate.Course</td><td>@certificate.CompletedOn.ToString("MMM d, yyyy")</td><td>@certificate.CertificateId</td></tr>
                }
            </tbody>
        </table>
    </div>
}
